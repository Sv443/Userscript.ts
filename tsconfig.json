{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2019",
    "outDir": "dist/out",
    "lib": [
      "ES2015",
      "ES2016",
      "ES2017",
      "ES2018",
      "ES2019",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "paths": {
      "@assets/*": ["./assets/*"],
      "@utils/*": ["./src/utils/*"],
      "@root/*": ["./*"],
      "@/*": ["./src/*"],
    },
  },
  "include": [
    "src/**/*",
    "node_modules/vite-userscript-plugin/types/violentmonkey.d.ts",
  ],
  "exclude": [
    "node_modules/**/*",
    "**/*.js",
    "dist/**",
  ],
}
